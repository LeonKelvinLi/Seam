    "e2e": "tsx scripts/e2e.ts",
    "secrets:push": "node scripts/push-secrets.mjs --apply",
    "secrets:check": "node scripts/push-secrets.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "better-sqlite3": "^12.2.0",
    "next": "^16.4.3",
    "openai": "^7.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5",
    "stripe": "^22.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
