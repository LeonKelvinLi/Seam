# ---- Seam configuration ------------------------------------------------------
# Everything is optional. With no keys set, Seam runs fully local:
#   analysis  -> heuristic (sharp-based pixel statistics)
#   generation-> procedural ffmpeg bridge (preview tier)
#   judge     -> heuristic frame comparison

# OpenAI: visual understanding, transition ideation, quality judging.
OPENAI_API_KEY=
SEAM_VISION_MODEL=gpt-5.4-mini
SEAM_JUDGE_MODEL=gpt-5.4-mini

# Video generation providers (first/last-frame capable).
FAL_KEY=
RUNWAYML_API_SECRET=
# Higgsfield developer API (platform key id + secret) — DoP and Veo 3.1 first→last-frame bridges
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# Generation policy
SEAM_MAX_ATTEMPTS=3
SEAM_QUALITY_THRESHOLD=72
# preview | final  (preview routes to cheap/fast models, final to best quality)
SEAM_DEFAULT_MODE=preview
# Force a provider for every generation: local | fal | runway  (leave empty = router decides)
SEAM_FORCE_PROVIDER=

# Paths
SEAM_DATA_DIR=./data
FFMPEG_PATH=
FFPROBE_PATH=

# Public base URL for share links (defaults to request origin)
SEAM_PUBLIC_URL=

# ---- Accounts & payments ----------------------------------------------------
# Accounts use email + password or Google, with sessions in SQLite. New accounts receive 6 trial credits:
# 3 preview runs at 2 credits each. Final renders cost 6 credits.
# Stripe, option A: Checkout sessions created by the app (recommended)
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
# Stripe, option B: Payment Links from the dashboard (the app appends client_reference_id for the webhook)
STRIPE_LINK_STARTER=
STRIPE_LINK_PRO=
STRIPE_LINK_STUDIO=
# Webhook signing secret for POST /api/stripe/webhook. Subscribe the endpoint to checkout.session.completed,
# checkout.session.async_payment_succeeded and charge.refunded (refunds take the credits back).
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=

# Only for `npm run secrets:push` (pushes the keys above to the Render service without printing them)
RENDER_API_KEY=
RENDER_SERVICE_ID=srv-daeromf40ujc738ft0t0
# Judge threshold for preview bridges (final uses SEAM_QUALITY_THRESHOLD, default 72). Below 70 the judge passed
# visibly melting dissolves in the 2026-09-10 proof runs.
SEAM_QUALITY_THRESHOLD_PREVIEW=70
# Bridge models tried at once on the first round (2 halves the wait at double provider cost)
SEAM_PARALLEL_ATTEMPTS=1
# Provider fees allowed per UTC day before runs fall back to ffmpeg (0 disables)
SEAM_DAILY_PROVIDER_BUDGET_USD=25
# Sign in with Google (OAuth client of type "Web application" in Google Cloud). Authorized redirect URI:
# <public origin>/api/auth/google/callback, e.g. https://seamcut.onrender.com/api/auth/google/callback.
# The button appears only when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Transactional mail (password reset, email confirmation) via Resend
# Use a sender on a domain verified in the Resend account; leaving either value empty disables delivery.
RESEND_API_KEY=
SEAM_MAIL_FROM=
# Verified business details shown on the legal pages; do not substitute placeholder contact information.
SEAM_COMPANY_NAME=BEASTY LLC
SEAM_COMPANY_ADDRESS=
# Public contact mailbox and Reply-To for transactional email; may use a Gmail address.
SEAM_SUPPORT_EMAIL=
# Enables private /ops and /api/metrics with Authorization: Bearer <token>; server-only.
SEAM_OPS_TOKEN=

# Launch readiness: fal's account billing API needs ADMIN scope (generation keys often return 403).
FAL_ADMIN_KEY=
SEAM_FAL_LOW_BALANCE_USD=5
# Private S3/R2 destination. No uploads happen until BUCKET is set.
SEAM_BACKUP_BUCKET=
SEAM_BACKUP_ENDPOINT=
SEAM_BACKUP_REGION=auto
SEAM_BACKUP_PREFIX=seamcut
SEAM_BACKUP_ACCESS_KEY_ID=
SEAM_BACKUP_SECRET_ACCESS_KEY=
