# ---- Seam configuration ------------------------------------------------------
# Everything is optional. With no keys set, Seam runs fully local:
#   analysis  -> heuristic (sharp-based pixel statistics)
#   generation-> procedural ffmpeg bridge (preview tier)
#   judge     -> heuristic frame comparison

# OpenAI: visual understanding, transition ideation, quality judging.
OPENAI_API_KEY=
SEAM_VISION_MODEL=gpt-5.4-mini
SEAM_JUDGE_MODEL=gpt-5.4-mini

# Video generation providers (first/last-frame capable).
FAL_KEY=
RUNWAYML_API_SECRET=

# Generation policy
SEAM_MAX_ATTEMPTS=3
SEAM_QUALITY_THRESHOLD=70
# preview | final  (preview routes to cheap/fast models, final to best quality)
SEAM_DEFAULT_MODE=preview
# Force a provider for every generation: local | fal | runway  (leave empty = router decides)
SEAM_FORCE_PROVIDER=

# Paths
SEAM_DATA_DIR=./data
FFMPEG_PATH=
FFPROBE_PATH=

# Public base URL for share links (defaults to request origin)
SEAM_PUBLIC_URL=

# ---- Accounts & payments ----------------------------------------------------
# Accounts work out of the box (email + password, sessions in SQLite). New accounts start with 5 credits.
# Stripe, option A: Checkout sessions created by the app (recommended)
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
# Stripe, option B: Payment Links from the dashboard (the app appends client_reference_id for the webhook)
STRIPE_LINK_STARTER=
STRIPE_LINK_PRO=
STRIPE_LINK_STUDIO=
# Webhook signing secret for POST /api/stripe/webhook (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=
